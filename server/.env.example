# ===== 应用 =====
APP_NAME=MemoryBridge Server
APP_VERSION=0.1.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ===== PostgreSQL =====
POSTGRES_USER=memorybridge
POSTGRES_PASSWORD=memorybridge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memorybridge

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== LLM 模式: api | ollama =====
LLM_MODE=api
# 当 LLM_MODE=api 时: deepseek | qwen
LLM_PROVIDER=deepseek

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 通义千问 ---
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v2

# --- Ollama（本地自部署）---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ===== 向量维度 =====
# 通义 text-embedding-v2 为 1536，nomic-embed-text 为 768
# 请根据实际使用的 Embedding 模型调整
EMBEDDING_DIM=1024

# ===== RAG =====
MEMORY_TOP_K=5
SESSION_HISTORY_TURNS=5
SESSION_TTL=86400

# ===== TTS =====
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# ===== 生成参数 =====
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# ===== CORS =====
CORS_ORIGINS=["*"]
